# Copie ce fichier en watcher.env et remplis les valeurs.
# WATCHER_COMBO_MODEL = nom du combo OmniRoute a utiliser pour la reformulation
#                       (ex: "reformat-combo"). Laisse vide pour desactiver la
#                       reformulation (proxy pass-through uniquement).
#                       "{model}" est remplace par le modele demande par Hermes.
WATCHER_LISTEN=127.0.0.1:20500
WATCHER_UPSTREAM=http://localhost:20128
WATCHER_COMBO_MODEL=
WATCHER_API_KEY=
WATCHER_MIN_WORDS=4
WATCHER_TIMEOUT=30
# Affiche la reformulation dans la reponse de l'agent (note "> Reformule : ...")
WATCHER_SHOW_REWRITE=1
